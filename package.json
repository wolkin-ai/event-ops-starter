{
  "name": "event-ops-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "arch:check": "dependency-cruiser --config dependency-cruiser.cjs src",
    "typecheck": "next typegen && node scripts/ensure-next-typegen-artifacts.mjs && tsc --noEmit --incremental false",
    "test": "vitest run --project unit",
    "test-storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:observability": "node scripts/check/observability.mjs",
    "check:postgres": "node scripts/check/postgres.mjs",
    "check:preview": "node scripts/check/preview-rehearsal.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed-local-db.ts",
    "db:reset-local": "prisma migrate reset --force",
    "db:prepare": "npm run db:generate && npm run db:migrate:deploy && npm run db:seed",
    "skills:sync": "node scripts/sync-skill-adapters.mjs",
    "skills:validate": "node scripts/validate-skills.mjs",
    "cleanup:check": "node scripts/check-harness-cleanliness.mjs",
    "worktree:policy": "node scripts/check-worktree-policy.mjs",
    "worktree:check": "npm run worktree:policy && vitest run --project unit src/lib/harness/worktree-harness-acceptance.test.ts",
    "boundary:check": "node scripts/check-boundary-contracts.mjs",
    "review:architecture": "./bin/codex-review architecture",
    "review:security": "./bin/codex-review security",
    "review:performance": "./bin/codex-review performance",
    "review:investigate": "./bin/codex-review investigate",
    "review:suite": "node scripts/run-review-suite.mjs",
    "verify:all": "npm run format:check && npm run db:prepare && npm run lint && npm run skills:validate && npm run cleanup:check && npm run worktree:check && npm run boundary:check && npm run arch:check && npm run typecheck && npm run test && npm run build && npm run build-storybook && npm run test-storybook && npm run test:e2e"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.18.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-a11y": "^10.2.16",
    "@storybook/addon-docs": "^10.2.16",
    "@storybook/addon-vitest": "^10.2.16",
    "@storybook/nextjs-vite": "^10.2.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "dependency-cruiser": "^17.3.8",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-storybook": "^10.2.16",
    "jsdom": "^28.1.0",
    "msw": "^2.12.10",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "storybook": "^10.2.16",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
